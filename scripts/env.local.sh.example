# Local machine config for the launcher and batch experiment scripts
# (see scripts/launch/ and scripts/experiments/).
# Copy this file to `env.local.sh` in the same directory (scripts/) and fill in
# the values for YOUR machine. `env.local.sh` is git-ignored and must never be
# committed.
#
#   cp scripts/env.local.sh.example scripts/env.local.sh
#   $EDITOR scripts/env.local.sh
#
# The launcher and sweep scripts `source` this file to learn machine-specific
# paths without hard-coding them into the (open-source) scripts themselves.

# Absolute path to the Python environment's activate script.
# Example (uv/venv): /path/to/uv-env/bin/activate
export VENV_ACTIVATE=""

# Proxy URL used to reach remote assets during training.
# Leave empty to disable proxy. Equivalent to `proxy_on` in your shell rc:
# the scripts export http_proxy/https_proxy/HTTP_PROXY/HTTPS_PROXY from this.
# Example: http://host:port
export PROXY_URL=""
